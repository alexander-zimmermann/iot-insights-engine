{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/alexander-zimmermann/iot-insights-engine/schemas/faults.schema.json",
  "title": "Fault list",
  "description": "Declares the faults the engine detects. Per fault: the sentence with its unit, a measurement kind with parameters in the channel's own unit, the target group address, and the channel scope as a catalog query.",
  "type": "object",
  "properties": {
    "faults": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/fault" }
    }
  },
  "required": ["faults"],
  "additionalProperties": false,
  "$defs": {
    "fault": {
      "type": "object",
      "properties": {
        "name":       { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "sentence":   { "type": "string", "minLength": 1 },
        "unit":       { "type": "string", "minLength": 1 },
        "kind":       { "enum": ["drift", "duration", "deviation", "silence", "constancy", "external", "volume"] },
        "signal":     { "enum": ["standby", "duty_cycle"] },
        "parameters": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "number" }
        },
        "devices":    { "$ref": "#/$defs/devices" },
        "references": { "$ref": "#/$defs/references" },
        "roles":      { "$ref": "#/$defs/roles" },
        "rooms":      { "$ref": "#/$defs/rooms" },
        "scope":      { "$ref": "#/$defs/scope" },
        "target":     { "$ref": "#/$defs/target" },
        "dormant":    { "$ref": "#/$defs/dormant" }
      },
      "required": ["name", "sentence", "unit", "kind"],
      "additionalProperties": false,
      "allOf": [
        {
          "if":   { "properties": { "kind": { "const": "volume" } }, "required": ["kind"] },
          "then": { "properties": { "parameters": { "required": ["max_episodes_per_week"] } } },
          "else": { "required": ["scope"] }
        },
        {
          "if":   { "properties": { "kind": { "const": "silence" } }, "required": ["kind"] },
          "then": {
            "properties": {
              "parameters": {
                "required": ["gap_factor", "gap_quantile"],
                "properties": {
                  "gap_quantile": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
                }
              }
            }
          }
        },
        {
          "if":   { "properties": { "kind": { "const": "external" } }, "required": ["kind"] },
          "else": { "required": ["parameters", "target"] }
        },
        {
          "if":   { "properties": { "kind": { "const": "duration" } }, "required": ["kind"] },
          "then": {
            "required": ["devices"],
            "properties": { "parameters": { "required": ["active_hour_fraction"] } }
          }
        },
        {
          "if":   { "properties": { "kind": { "const": "drift" } }, "required": ["kind"] },
          "then": {
            "required": ["signal", "references"],
            "properties": {
              "parameters": {
                "required": ["window_hours", "min_window_fraction"],
                "properties": {
                  "window_hours":        { "type": "number", "exclusiveMinimum": 0 },
                  "min_window_fraction": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "kind": { "const": "drift" }, "signal": { "const": "standby" } },
            "required": ["kind", "signal"]
          },
          "then": {
            "properties": {
              "parameters": {
                "required": ["rise_ma", "budget_ma_h"],
                "properties": {
                  "rise_ma":     { "type": "number", "exclusiveMinimum": 0 },
                  "budget_ma_h": { "type": "number", "exclusiveMinimum": 0 }
                }
              },
              "references": { "$ref": "#/$defs/standbyReferences" }
            }
          }
        },
        {
          "if": {
            "properties": { "kind": { "const": "drift" }, "signal": { "const": "duty_cycle" } },
            "required": ["kind", "signal"]
          },
          "then": {
            "properties": {
              "parameters": {
                "required": ["rise_pct", "budget_pct_h", "door_run_hours", "on_ma"],
                "properties": {
                  "rise_pct":       { "type": "number", "exclusiveMinimum": 0, "maximum": 100 },
                  "budget_pct_h":   { "type": "number", "exclusiveMinimum": 0 },
                  "door_run_hours": { "type": "number", "exclusiveMinimum": 0 },
                  "on_ma":          { "type": "number", "exclusiveMinimum": 0 }
                }
              },
              "references": { "$ref": "#/$defs/dutyCycleReferences" }
            }
          }
        },
        {
          "if":   { "properties": { "kind": { "const": "deviation" } }, "required": ["kind"] },
          "then": {
            "required": ["roles", "rooms"],
            "properties": { "parameters": { "required": ["min_hours"] } }
          }
        }
      ]
    },
    "devices": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "properties": {
          "max_run_hours": { "type": "number", "exclusiveMinimum": 0 }
        },
        "required": ["max_run_hours"],
        "additionalProperties": false
      }
    },
    "references": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "object" }
    },
    "standbyReferences": {
      "additionalProperties": {
        "properties": {
          "healthy_ma": { "type": "number", "minimum": 0 }
        },
        "required": ["healthy_ma"],
        "additionalProperties": false
      }
    },
    "dutyCycleReferences": {
      "additionalProperties": {
        "properties": {
          "healthy_duty_pct": { "type": "number", "minimum": 0, "maximum": 100 }
        },
        "required": ["healthy_duty_pct"],
        "additionalProperties": false
      }
    },
    "roles": {
      "type": "object",
      "properties": {
        "reference": { "type": "string", "minLength": 1 },
        "gate":      { "type": "string", "minLength": 1 }
      },
      "required": ["reference"],
      "additionalProperties": false
    },
    "rooms": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "properties": {
          "min_gap_k": { "type": "number", "exclusiveMinimum": 0 },
          "value":     { "type": "string", "minLength": 1 }
        },
        "required": ["min_gap_k", "value"],
        "additionalProperties": false
      }
    },
    "scope": {
      "type": "object",
      "properties": {
        "dpt":               { "$ref": "#/$defs/stringOrList" },
        "name_like":         { "$ref": "#/$defs/stringOrList" },
        "exclude_name_like": { "$ref": "#/$defs/stringOrList" }
      },
      "minProperties": 1,
      "additionalProperties": false
    },
    "target": {
      "oneOf": [
        {
          "type": "object",
          "properties": { "ga": { "type": "string", "pattern": "^[0-9]+/[0-9]+/[0-9]+$" } },
          "required": ["ga"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": { "per_main_group": { "const": true } },
          "required": ["per_main_group"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": { "per_device": { "const": true } },
          "required": ["per_device"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": { "per_room": { "const": true } },
          "required": ["per_room"],
          "additionalProperties": false
        }
      ]
    },
    "dormant": {
      "type": "object",
      "properties": {
        "reason":      { "type": "string", "minLength": 1 },
        "active_when": { "type": "string", "minLength": 1 }
      },
      "required": ["reason", "active_when"],
      "additionalProperties": false
    },
    "stringOrList": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      ]
    }
  }
}
